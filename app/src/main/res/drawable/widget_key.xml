<?xml version="1.0" encoding="utf-8"?>
<!-- Cream piano key with a darker lower lip, like the deck's transport keys. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF9E9384" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FFD9D0C2"
                android:startColor="#FFF6F1E8" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
