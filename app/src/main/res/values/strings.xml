    <string name="onb1_title">Press REC on your memories</string>
    <string name="onb1_body">A real cassette deck in your pocket: spinning reels, VU meters and chunky piano keys, with modern recording that keeps going in the background.</string>
    <string name="onb_keys_title">Play it like a real deck</string>
    <string name="onb_keys_body">The piano keys latch down just like the real thing.</string>
    <string name="onb_key_rec">Start recording on the tape in the deck. It keeps going with the screen off.</string>
    <string name="onb_key_pause">Pause and resume recording or playback.</string>
    <string name="onb_key_stop">Stop and save. Press again while stopped to eject the tape.</string>
    <string name="onb_key_play">Play the side that\'s in the deck.</string>
    <string name="onb_key_wind">Wind the tape fast. Press again to stop, or PLAY to listen from there.</string>
    <string name="onb_wind_label">REW / FF</string>
    <string name="onb_side_label">SIDE A / B</string>
    <string name="onb_key_side">Flip the cassette to record or play the other side.</string>
    <string name="onb2_title">A shelf of mixtapes</string>
    <string name="onb2_body">Organize recordings on your own cassettes, one for each part of your life.</string>
    <string name="onb2_point1">Side A and Side B on every tape</string>
    <string name="onb2_point2">Hand-written labels, shell colors and cover art</string>
    <string name="onb2_point3">Rename, tag, move, share or save any recording</string>
    <string name="onb_diary_title">Every day, on tape</string>
    <string name="onb_diary_body">Your recordings become a diary you can actually find your way around.</string>
    <string name="onb_diary_point1">Browse by date, search titles, tags and tapes</string>
    <string name="onb_diary_point2">Favorites, day streaks and totals</string>
    <string name="onb_diary_point3">\"On this day\" brings back what you said a year ago</string>
    <string name="onb3_title">Letters to the future</string>
    <string name="onb3_body">Seal a message until a date you choose: next month, a birthday or five years from now.</string>
    <string name="onb3_point1">Sealed tapes can\'t be played until the day comes</string>
    <string name="onb3_point2">A notification at 9:00 AM the morning it opens</string>
    <string name="onb3_point3">Add a written letter to read alongside it</string>
    <string name="onb_style_title">Make it yours</string>
    <string name="onb_style_body">Pick a deck finish. You can change it any time in Settings.</string>
    <string name="onb4_title" formatted="false">Yours alone. 100% offline.</string>
    <string name="onb4_body">No account, no cloud, no internet permission. TapeBack only asks for two things:</string>
    <string name="onb_perm_mic">Microphone</string>
    <string name="onb_perm_mic_body">Needed to record your voice. Used only while REC is down.</string>
    <string name="onb_perm_notif">Notifications</string>
    <string name="onb_perm_notif_body">Pause and stop controls while you record, and a note when a capsule opens.</string>
    <string name="onb_perm_allow">Allow</string>
    <string name="onb_perm_granted">Allowed</string>
    <string name="onb_perm_later">You can change these any time in Settings.</string>
