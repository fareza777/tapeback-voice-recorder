    <!-- Onboarding -->
    <string name="onb_skip">Skip</string>
    <string name="onb_next">Next</string>
    <string name="onb_start">Get started</string>
    <string name="onb1_title">Press REC on your memories</string>
    <string name="onb1_body">A real cassette deck in your pocket: spinning reels, VU meters and chunky piano keys, with modern recording that keeps going in the background.</string>
    <string name="onb2_title">A shelf of mixtapes</string>
    <string name="onb2_body">Organize recordings on custom cassettes with Side A and B, labels, shells and cover art.</string>
    <string name="onb3_title">Letters to the future</string>
    <string name="onb3_body">Seal a message until a date you choose. It unlocks with a notification, even years from now.</string>
    <string name="onb4_title" formatted="false">Yours alone. 100% offline.</string>
    <string name="onb4_body">No account, no cloud, no internet permission. TapeBack asks for two things:</string>
    <string name="onb_perm_mic">Microphone, to record your voice</string>
    <string name="onb_perm_notif">Notifications, for recording controls and capsule unlocks</string>
