<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TapeBack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.TapeBack.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.TapeBack</item>
    </style>
</resources>
